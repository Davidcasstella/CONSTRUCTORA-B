# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================
NODE_ENV=development
PORT=3001

# ===========================================
# GROQ (Proveedor alternativo - rápido y gratuito)
# ===========================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===========================================
# OPENAI (Proveedor principal)
# ===========================================
OPENAI_API_KEY=

# ===========================================
# WHATSAPP PROVIDER
# ===========================================
# Opciones: 'baileys' (recomendado) o 'web' (whatsapp-web.js)
WHATSAPP_PROVIDER=baileys

# ===========================================
# WHATSAPP - META (Cloud API) - NO USADO CON BAILEYS
# ===========================================
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v18.0

# ===========================================
# BASE DE CONOCIMIENTO
# ===========================================
KNOWLEDGE_FILE=./PreguntasRespuestas.txt

# ===========================================
# ARCHIVOS Y MEDIA
# ===========================================
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,mp3,ogg,mp4,3gp,pdf,webm,wav,doc,docx,xls,xlsx,ppt,pptx,txt

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug
LOG_DIR=./logs

# ===========================================
# EMBEDDINGS - BÚSQUEDA VECTORIAL
# ===========================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
USE_EMBEDDINGS=true

# ===========================================
# FLUJO DE MENÚ PRINCIPAL
# ===========================================
USE_NEW_MENU_FLOW=true

# ===========================================
# ZONA HORARIA
# ===========================================
TIMEZONE=America/Bogota

# ===========================================
# CONTROL ANTI-SPAM
# ===========================================
SPAM_MAX_REPEATED=3
SPAM_SIMILARITY_THRESHOLD=0.9
SPAM_HISTORY_SIZE=10

# ===========================================
# AWS CONFIGURATION
# ===========================================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===========================================
# DYNAMODB TABLE NAMES
# ===========================================
DYNAMODB_CONVERSATIONS_TABLE=
DYNAMODB_MESSAGES_TABLE=
DYNAMODB_HOLIDAYS_TABLE=
DYNAMODB_CONTACT_LISTS_TABLE=
DYNAMODB_CONTACTS_TABLE=
DYNAMODB_BULK_CAMPAIGNS_TABLE=
DYNAMODB_BULK_MESSAGES_TABLE=
DYNAMODB_MESSAGE_TEMPLATES_TABLE=

# ===========================================
# S3 MEDIA STORAGE
# ===========================================
AWS_S3_BUCKET=

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ===========================================
# CORS / FRONTEND
# ===========================================
# Comma-separated list of allowed origins (beyond localhost)
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=

# ===========================================
# GOOGLE CALENDAR (Service Account)
# ===========================================
# Option A: Path to the service account JSON file (for local dev)
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json
# Option B: Base64-encoded service account JSON (for cloud/AWS — no file needed)
# Generate with: base64 -w 0 google-service-account.json
# If both are set, GOOGLE_SERVICE_ACCOUNT_BASE64 takes priority
GOOGLE_SERVICE_ACCOUNT_BASE64=
# Calendar ID to book appointments into (use email or 'primary')
GOOGLE_CALENDAR_ID=your-calendar@gmail.com
# Timezone for appointments
GOOGLE_CALENDAR_TIMEZONE=America/Bogota
