# ===========================================
# FRONTEND ENVIRONMENT VARIABLES
# ===========================================

# Backend API URL (only needed for non-localhost, non-HTTPS deployments)
# For HTTPS: leave empty (same-origin proxy)
# For localhost: auto-detected (http://localhost:3001)
# For other: set the full URL (e.g., http://your-server-ip:3001)
VITE_API_URL=
